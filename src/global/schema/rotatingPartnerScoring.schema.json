{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Internal rotating-partner scoring contract groundwork",
  "$comment": "Not referenced by tournament.schema.json. This does not enable timed profiles or writes. Runtime policy validation additionally requires defaultVariant to belong to permittedVariants.",
  "definitions": {
    "Variant": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tieResolution": {
              "enum": ["ALLOW", "DECIDING_POINT"]
            }
          },
          "required": ["tieResolution"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tieResolution": {
              "const": "WIN_BY_MARGIN"
            },
            "winningMargin": {
              "type": "integer",
              "minimum": 2,
              "maximum": 9007199254740991
            }
          },
          "required": ["tieResolution", "winningMargin"]
        }
      ]
    },
    "TimedVariant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tieResolution": {
          "enum": ["ALLOW", "DECIDING_POINT"]
        }
      },
      "required": ["tieResolution"]
    },
    "CombinedConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "COMBINED_POINTS"
        },
        "combinedPointTotal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "selectedVariant": {
          "$ref": "#/definitions/Variant"
        }
      },
      "required": ["combinedPointTotal"]
    },
    "TimedConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "TIMED"
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "selectedVariant": {
          "$ref": "#/definitions/TimedVariant"
        }
      },
      "required": ["kind", "minutes"]
    },
    "ScoringConfiguration": {
      "oneOf": [
        {
          "$ref": "#/definitions/CombinedConfiguration"
        },
        {
          "$ref": "#/definitions/TimedConfiguration"
        }
      ]
    },
    "CombinedContract": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "COMBINED_POINTS"
            },
            "combinedPointTotal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "tieResolution": {
              "enum": ["ALLOW", "DECIDING_POINT"]
            }
          },
          "required": ["combinedPointTotal", "tieResolution"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "COMBINED_POINTS"
            },
            "combinedPointTotal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "tieResolution": {
              "const": "WIN_BY_MARGIN"
            },
            "winningMargin": {
              "type": "integer",
              "minimum": 2,
              "maximum": 9007199254740991
            }
          },
          "required": ["combinedPointTotal", "tieResolution", "winningMargin"]
        }
      ]
    },
    "TimedContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "TIMED"
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tieResolution": {
          "enum": ["ALLOW", "DECIDING_POINT"]
        }
      },
      "required": ["kind", "minutes", "tieResolution"]
    },
    "ScoreContract": {
      "oneOf": [
        {
          "$ref": "#/definitions/CombinedContract"
        },
        {
          "$ref": "#/definitions/TimedContract"
        }
      ]
    },
    "TimedPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultVariant": {
          "$ref": "#/definitions/TimedVariant"
        },
        "permittedVariants": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TimedVariant"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "permittedMinutes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["defaultVariant", "permittedVariants"]
    },
    "ScoringPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultVariant": {
          "$ref": "#/definitions/Variant"
        },
        "permittedVariants": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Variant"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "permittedPointTotals": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "timed": {
          "$ref": "#/definitions/TimedPolicy"
        }
      },
      "required": ["defaultVariant", "permittedVariants"]
    }
  }
}
