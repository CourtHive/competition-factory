# every line must pass; husky runs this under `sh -e`, and `set -e` makes that true under any runner too
set -e
pnpm lint-staged
pnpm check-types
# The cheap gates CI's `gates` job runs, so a ratchet rise is refused here and not twenty minutes into a CI run
# (CA, 2026-10-07; #5269 lost a run to implicit-any, #5270 to any-count). About 20s on top of check-types.
pnpm verify:generated
pnpm verify:test-types
pnpm verify:implicit-any
pnpm verify:hard-union
pnpm verify:exit-tenant
