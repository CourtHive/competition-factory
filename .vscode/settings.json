{
  "files.associations": {
    "*.jsonc": "jsonc"
  },
  "sonarlint.rules": {
    "typescript:S3776": {
      "level": "on",
      "parameters": {
        "threshold": "30"
      }
    }
  },
  "files.watcherExclude": {
    "**/.worktrees/**": true,
    "**/node_modules/**": true,
    "**/coverage/**": true,
    "**/dist/**": true
  },
  "search.exclude": {
    "**/.worktrees/**": true,
    "**/coverage/**": true
  }
}
